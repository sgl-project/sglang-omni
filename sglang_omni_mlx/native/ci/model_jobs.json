{
  "shared_paths": [
    "^\\.github/workflows/voxt-mac-ci\\.yaml$",
    "^\\.github/scripts/select_voxt_models\\.py$",
    "^sglang_omni_mlx/native/CMakeLists\\.txt$",
    "^sglang_omni_mlx/native/scripts/",
    "^sglang_omni_mlx/native/src/common/",
    "^sglang_omni_mlx/native/src/qwen3_asr/",
    "^sglang_omni_mlx/native/ci/(model_jobs\\.json|provision.*\\.py|check_.*\\.py|test_check_golden\\.py|test_model_servers\\.py|test_server_api\\.py|requirements\\.lock)$"
  ],
  "models": [
    {
      "name": "whisper",
      "paths": ["^sglang_omni_mlx/native/(src/whisper/|tools/whisper_|ci/model_golden/whisper-)"],
      "pins": [
        "mlx-community/whisper-large-v3-turbo",
        "mlx-community/whisper-large-v3-mlx",
        "mlx-community/whisper-small-mlx",
        "mlx-community/silero-vad-v6"
      ],
      "goldens": ["whisper-large-v3-turbo.json", "whisper-large-v3.json", "whisper-small.json"],
      "pytest": ["sglang_omni_mlx/native/ci/test_model_servers.py", "-k", "whisper"]
    },
    {
      "name": "cohere",
      "paths": ["^sglang_omni_mlx/native/(src/cohere/|tools/cohere_|ci/model_golden/cohere-)"],
      "pins": ["beshkenadze/cohere-transcribe-03-2026-mlx-fp16", "mlx-community/silero-vad-v6"],
      "goldens": ["cohere-transcribe-03-2026.json", "cohere-transcribe-03-2026-chunked.json"],
      "pytest": ["sglang_omni_mlx/native/ci/test_model_servers.py", "-k", "cohere"]
    },
    {
      "name": "moss-transcribe-diarize",
      "paths": ["^sglang_omni_mlx/native/(src/moss/|tools/moss_|ci/model_golden/moss-transcribe-)"],
      "pins": ["OpenMOSS-Team/MOSS-Transcribe-Diarize"],
      "goldens": ["moss-transcribe-diarize.json"],
      "pytest": ["sglang_omni_mlx/native/ci/test_model_servers.py", "-k", "moss"]
    },
    {
      "name": "nemotron",
      "paths": ["^sglang_omni_mlx/native/(src/nemotron/|tools/nemotron_|ci/model_golden/nemotron-)"],
      "pins": ["mlx-community/nemotron-3.5-asr-streaming-0.6b-8bit"],
      "goldens": ["nemotron-asr-streaming.json"],
      "pytest": ["sglang_omni_mlx/native/ci/test_model_servers.py", "-k", "nemotron"]
    },
    {
      "name": "parakeet",
      "paths": ["^sglang_omni_mlx/native/(src/parakeet/|tools/parakeet_|ci/model_golden/parakeet-)"],
      "pins": ["mlx-community/parakeet-tdt-0.6b-v3"],
      "goldens": ["parakeet-tdt-0.6b-v3.json"],
      "pytest": ["sglang_omni_mlx/native/ci/test_model_servers.py", "-k", "parakeet"]
    },
    {
      "name": "sensevoice",
      "paths": ["^sglang_omni_mlx/native/(src/sensevoice/|tools/sensevoice_|ci/model_golden/sensevoice-)"],
      "pins": ["mlx-community/SenseVoiceSmall", "mlx-community/silero-vad-v6"],
      "goldens": ["sensevoice-small.json"],
      "pytest": ["sglang_omni_mlx/native/ci/test_model_servers.py", "-k", "sensevoice"]
    },
    {
      "name": "voxtral-tts",
      "paths": ["^sglang_omni_mlx/native/(src/voxtral_tts/|tools/voxtral_tts_|ci/(voxtral_golden\\.py|test_voxtral_tts_api\\.py|model_golden/voxtral-))"],
      "pins": ["mlx-community/Voxtral-4B-TTS-2603-mlx-4bit"],
      "goldens": ["voxtral-4b-tts-2603.json"],
      "pytest": ["sglang_omni_mlx/native/ci/test_voxtral_tts_api.py"]
    },
    {
      "name": "music3",
      "paths": ["^sglang_omni_mlx/native/(src/music3/|tools/music3_|ci/(music3_|generate_music3_reference\\.py|model_golden/minimax-music3))"],
      "pins": ["mlx-community/MiniMax-Music3-mxfp8"],
      "goldens": ["minimax-music3.json"],
      "pytest": ["sglang_omni_mlx/native/ci/test_model_servers.py", "-k", "music3"]
    }
  ]
}
