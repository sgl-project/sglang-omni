# GitHub App credentials. Use either GITHUB_PRIVATE_KEY or GITHUB_PRIVATE_KEY_PATH.
GITHUB_APP_ID=3983847
GITHUB_PRIVATE_KEY_PATH=/Downloads/cischeduler.2026-06-06.private-key.pem
GITHUB_WEBHOOK_SECRET=explicit

# Optional local development fallback. If set, the app uses this token instead
# of minting installation tokens. Do not use a PAT in production.
GITHUB_TOKEN=

GITHUB_REPOSITORY=sgl-project/sglang-omni
DISPATCH_WORKFLOW_ID=scheduler-gpu-stage.yaml
DISPATCH_REF=main

RUN_LABEL=run-ci
HIGH_PRIORITY_LABEL=high-priority
RUNNER_CAPACITY=1

DATABASE_PATH=/data/ci-scheduler.sqlite3
STAGES_PATH=/app/stages.json

# Must match the secret configured as CI_SCHEDULER_CALLBACK_TOKEN in GitHub.
SCHEDULER_CALLBACK_TOKEN=explicit
