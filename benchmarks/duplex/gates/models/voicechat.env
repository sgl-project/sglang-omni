# Nemotron VoiceChat 11B: 80 ms frames, 16 kHz in, 22.05 kHz out, four stages (perception, thinker, talker, code2wav). Sourced by config.sh when MODEL=voicechat.
# Main serves it only through examples/run_nemotron_voicechat_duplex.py --serve, one session per server.
# shellcheck shell=bash disable=SC2034

MODEL_REPO=${MODEL_REPO:-nvidia/NVIDIA-NemotronLabs-VoiceChat-11B}
MODEL_REVISION=${MODEL_REVISION:-443794ea956ef0065f001967ffd00e77f519cb39}
MODEL_NAME=${MODEL_NAME:-NVIDIA-NemotronLabs-VoiceChat-11B}
# The checkpoint takes its tokenizer and backbone config from this sibling repo through the HF cache.
HUB_FILES=${HUB_FILES:-"nvidia/NVIDIA-Nemotron-Nano-9B-v2@6533e8de2c68e4536bf7c411d7a3ce5734111476:config.json,tokenizer.json,tokenizer_config.json,special_tokens_map.json"}
# SERVER_KIND voicechat runs examples/run_nemotron_voicechat_duplex.py --serve (no yaml; it warms up with two zero units first).
SERVER_KIND=${SERVER_KIND:-voicechat}
SERVER_YAML=${SERVER_YAML:-}
CLIENT_PROFILE=${CLIENT_PROFILE:-nemotron-voicechat-pr2188}
INPUT_SAMPLE_RATE=${INPUT_SAMPLE_RATE:-16000}
# session.update takes no prompt, voice or sampling for this model.
SESSION_UPDATE=${SESSION_UPDATE:-}
UNIT_MS=${UNIT_MS:-80}
# The deployment on main has max_connections=1; a second session is refused with 503. Raise MAX_LEVEL for a tree that serves more.
SWEEP_LEVELS=${SWEEP_LEVELS:-1}
MAX_LEVEL=${MAX_LEVEL:-1}
WARM_SESSIONS=${WARM_SESSIONS:-1}
WARM_SAMPLES=${WARM_SAMPLES:-4}
UNIT_TESTS=${UNIT_TESTS:-"tests/unit_test/nemotron_voicechat tests/unit_test/scheduling"}
# Perception and codec use per-session hooks (SessionScheduler.compute), not compute_batch.
STAGE_TIMING_SESSION_COMPUTE=${STAGE_TIMING_SESSION_COMPUTE:-1}
