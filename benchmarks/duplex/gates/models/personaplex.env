# PersonaPlex 7B: 80 ms frames at 24 kHz in and out, three stages (mimi_encode, lm, code2wav). Sourced by config.sh when MODEL=personaplex.
# The duplex pipeline is not on upstream main yet: test private perf/personaplex-duplex-opt (1b38ad7d8) or a tree on top of it.
# The checkpoint is gated: run setup_node.sh with HF_TOKEN of an account that accepted the license.
# shellcheck shell=bash disable=SC2034

MODEL_REPO=${MODEL_REPO:-nvidia/personaplex-7b-v1}
MODEL_REVISION=${MODEL_REVISION:-fdaf4090a61cb315c138a1faee287ffd6c716309}
MODEL_NAME=${MODEL_NAME:-personaplex-7b-v1}
HUB_FILES=${HUB_FILES:-}
SERVER_KIND=${SERVER_KIND:-cli}
SERVER_YAML=${SERVER_YAML:-examples/full_duplex/personaplex.yaml}
# personaplex-native is added to the recorder's profiles by frame_hook/model_client.py; the 16 kHz dataset audio is resampled to 24 kHz.
CLIENT_PROFILE=${CLIENT_PROFILE:-personaplex-native}
INPUT_SAMPLE_RATE=${INPUT_SAMPLE_RATE:-24000}
# Server defaults: voice NATF2 and the reference teacher prompt. Example: '{"sglang": {"voice": "NATM1"}, "instructions": "..."}'
SESSION_UPDATE=${SESSION_UPDATE:-}
UNIT_MS=${UNIT_MS:-80}
# About 4 GiB of KV per session at context 8192; 6 sessions is the measured starting point.
SWEEP_LEVELS=${SWEEP_LEVELS:-1,2,4,6,8,12,16}
MAX_LEVEL=${MAX_LEVEL:-}
WARM_SESSIONS=${WARM_SESSIONS:-4}
WARM_SAMPLES=${WARM_SAMPLES:-16}
UNIT_TESTS=${UNIT_TESTS:-"tests/unit_test/personaplex tests/unit_test/scheduling"}
STAGE_TIMING_SESSION_COMPUTE=${STAGE_TIMING_SESSION_COMPUTE:-0}
