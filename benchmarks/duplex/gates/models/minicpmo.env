# MiniCPM-o 4.5: 1 s units, four stages (perception, thinker, talker, speech). Sourced by config.sh when MODEL=minicpmo (the default).
# shellcheck shell=bash disable=SC2034

# Model checkpoint (Hugging Face tree at a fixed revision; every file is checked against its digest).
MODEL_REPO=${MODEL_REPO:-openbmb/MiniCPM-o-4_5}
MODEL_REVISION=${MODEL_REVISION:-503e754207c94da6bb26850b4469f367c9ea3582}
MODEL_NAME=${MODEL_NAME:-MiniCPM-o-4_5}
HUB_FILES=${HUB_FILES:-}  # extra <repo>@<revision>:<file>,<file> entries fetched into the container HF cache
# Server: SERVER_KIND cli runs `sglang_omni.cli serve --config <SERVER_YAML of the tree, adjusted>`.
SERVER_KIND=${SERVER_KIND:-cli}
SERVER_YAML=${SERVER_YAML:-examples/full_duplex/minicpmo-parity.yaml}
# Recorder: profile of benchmarks/duplex/profiles.py, input sample rate, JSON merged into session.update.
CLIENT_PROFILE=${CLIENT_PROFILE:-minicpmo-native-pr2377}
INPUT_SAMPLE_RATE=${INPUT_SAMPLE_RATE:-16000}
SESSION_UPDATE=${SESSION_UPDATE:-}
# One unit of audio: the deadline of a unit (miss = lag over UNIT_MS) and the unit of expected-unit accounting.
UNIT_MS=${UNIT_MS:-1000}
# Session levels: sweep default, largest level the tree can serve (empty: no limit), sessions of the warm-up run.
SWEEP_LEVELS=${SWEEP_LEVELS:-1,2,4,8,16,32,48,64}
MAX_LEVEL=${MAX_LEVEL:-}
WARM_SESSIONS=${WARM_SESSIONS:-8}
WARM_SAMPLES=${WARM_SAMPLES:-16}
UNIT_TESTS=${UNIT_TESTS:-"tests/unit_test/minicpm_o tests/unit_test/scheduling tests/unit_test/test_stage_device_contract.py"}
STAGE_TIMING_SESSION_COMPUTE=${STAGE_TIMING_SESSION_COMPUTE:-0}
