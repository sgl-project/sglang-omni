# sglang-omni router launcher config (local backend). Generated by run_router_condition.sh.
# worker_gpu_ids repeats the SAME physical GPU index once per worker to force same-card DP.
# model_name MUST equal the model string the client sends: the router matches workers by
# exact `worker.model == request.model`, else every request 503s "no eligible upstream".
launcher:
  backend: local
  model_path: __MODEL__
  model_name: __MODEL__
  num_workers: __NWORKERS__
  num_gpus_per_worker: 1
  worker_gpu_ids: __WORKER_GPU_IDS__
  worker_host: 127.0.0.1
  worker_base_port: 8901
  worker_extra_args: "--allowed-local-media-path /"
  wait_timeout: 900
