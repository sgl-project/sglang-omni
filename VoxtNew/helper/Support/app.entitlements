<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Entitlements of VoxtNew.app's own executable (mygo.json
     macos.entitlements); the helper's are helper.entitlements. Under the
     hardened runtime (Developer ID builds) the app asks for the microphone
     itself when the helper cannot (permissions.go), and macOS holds it
     responsible for the helper's recording. Nothing else: no JIT, no
     unsigned memory, no library validation exception (purego loads system
     frameworks; the SQLite library is signed with the app). -->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
