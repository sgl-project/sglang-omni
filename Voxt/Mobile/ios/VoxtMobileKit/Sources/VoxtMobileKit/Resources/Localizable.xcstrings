            "value" : "No se puede conectar con tu Mac"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac に接続できません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac에 연결할 수 없음"
          }
        },
        "zh-Hans" : {
