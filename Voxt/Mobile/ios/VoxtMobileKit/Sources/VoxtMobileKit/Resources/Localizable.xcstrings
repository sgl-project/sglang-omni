    },
    "Off by default. When enabled, your Mac may send audio and text to its selected cloud providers." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off by default. When enabled, your Mac may send audio and text to its selected cloud providers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado por defecto. Si lo activas, tu Mac puede enviar audio y texto a los proveedores en la nube que tenga seleccionados."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "初期設定はオフです。有効にすると、Mac が選択したクラウドサービスに音声やテキストを送信する場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본값은 꺼짐입니다. 켜면 Mac이 선택한 클라우드 서비스로 오디오와 텍스트를 보낼 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认关闭。开启后，Mac 可能向所选云端服务发送音频和文字。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預設關閉。開啟後，Mac 可能向所選雲端服務傳送音訊和文字。"
          }
        }
      }
    },
    "Off: inserts your words as spoken, without cleanup. Faster." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off: inserts your words as spoken, without cleanup. Faster."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado: inserta tus palabras tal como las dices, sin limpiarlas. Más rápido."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフ：話したとおりに入力し、整えません。より速くなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끄면: 말한 그대로 다듬지 않고 넣습니다. 더 빠릅니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭：按原话输入，不做整理。更快。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉：照原話輸入，不做整理。更快。"
          }
        }
      }
    },
    "Off: your voice and text stay on this iPhone and your Mac." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off: your voice and text stay on this iPhone and your Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado: tu voz y tu texto se quedan en este iPhone y en tu Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフ：音声とテキストはこの iPhone とあなたの Mac から出ません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끄면: 음성과 텍스트가 이 iPhone과 Mac에만 머뭅니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭：你的语音和文字只留在这台 iPhone 和你的 Mac 上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉：你的語音和文字只留在這支 iPhone 和你的 Mac 上。"
          }
        }
      }
    },
    "On the keyboard, hold the mic and slide up to a language. Your words come out in that language." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On the keyboard, hold the mic and slide up to a language. Your words come out in that language."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el teclado, mantén pulsado el micrófono y desliza hacia arriba hasta un idioma. Lo que digas saldrá en ese idioma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーボードでマイクを長押しし、上にスライドして言語を選びます。話した内容がその言語で入力されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키보드에서 마이크를 길게 누른 채 위로 밀어 언어를 고르세요. 말한 내용이 그 언어로 나옵니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在键盘上按住麦克风，向上滑到一种语言。你说的话会以那种语言写出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在鍵盤上按住麥克風，向上滑到一種語言。你說的話會以那種語言寫出。"
          }
        }
      }
    },
