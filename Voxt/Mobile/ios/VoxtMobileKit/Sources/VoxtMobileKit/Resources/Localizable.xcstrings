          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャンセル"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "취소"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取消"
          }
        },
        "zh-Hant" : {
