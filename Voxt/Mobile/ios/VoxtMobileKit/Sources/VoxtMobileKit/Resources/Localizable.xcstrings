          }
        }
      }
    },
    "Use your preferred spelling and Chinese script when writing in these languages. Translation uses the target language you choose." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use your preferred spelling and Chinese script when writing in these languages. Translation uses the target language you choose."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa tu ortografía preferida y la escritura china que prefieras al escribir en estos idiomas. La traducción usa el idioma de destino que elijas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらの言語で書く際に、好みの綴りや中国語の字体を使います。翻訳では選択したターゲット言語を使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 언어로 쓸 때 원하는 철자와 중국어 문자 체계를 사용합니다. 번역은 고른 대상 언어를 따릅니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用这些语言写作时，会使用你偏好的拼写和中文形体。翻译则使用你选择的目标语言。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用這些語言寫作時，會使用你偏好的拼寫和中文字形。翻譯則使用你選擇的目標語言。"
          }
        }
      }
    },
    "Uses your Mac’s selected models. If a result doesn’t land in the other app, tap it here to copy." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
