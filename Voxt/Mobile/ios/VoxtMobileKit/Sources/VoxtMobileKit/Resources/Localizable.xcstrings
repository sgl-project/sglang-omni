    "Choose Dictate, tap the mic, and speak. Tap again to finish. Voxt removes fillers and repetition while keeping your spoken language." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose Dictate, tap the mic, and speak. Tap again to finish. Voxt removes fillers and repetition while keeping your spoken language."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige Dictar, toca el micrófono y habla. Toca otra vez para terminar. Voxt quita muletillas y repeticiones y mantiene el idioma en que hablas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「書き取り」を選び、マイクをタップして話してください。もう一度タップで完了です。Voxt はフィラーや繰り返しを除き、話した言語のまま整えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "받아쓰기를 고르고 마이크를 탭한 뒤 말하세요. 다시 탭하면 끝납니다. Voxt는 군말과 반복을 지우고 말한 언어는 그대로 둡니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择“听写”，轻点麦克风，然后说话。再点一次结束。Voxt 会去掉口头禅和重复，保留你所说的语言。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇「聽寫」，輕點麥克風，然後說話。再點一次結束。Voxt 會去除口頭禪與重複，保留你說的語言。"
          }
        }
      }
    },
    "Choose Dictate, tap the mic, and speak. Voxt removes fillers and repetition while keeping your spoken language." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose Dictate, tap the mic, and speak. Voxt removes fillers and repetition while keeping your spoken language."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige Dictar, toca el micrófono y habla. Voxt quita muletillas y repeticiones y mantiene el idioma en que hablas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「書き取り」を選び、マイクをタップして話してください。Voxt はフィラーや繰り返しを除き、話した言語のまま整えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "받아쓰기를 고르고 마이크를 탭한 뒤 말하세요. Voxt는 군말과 반복을 지우고 말한 언어는 그대로 둡니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择“听写”，轻点麦克风，然后说话。Voxt 会去掉口头禅和重复，保留你所说的语言。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇「聽寫」，輕點麥克風，然後說話。Voxt 會去除口頭禪與重複，保留你說的語言。"
          }
        }
      }
    },
    "Choose Translate and a target language, then speak. Add or reorder your target languages on Home; switch between them from the keyboard." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose Translate and a target language, then speak. Add or reorder your target languages on Home; switch between them from the keyboard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige Traducir y un idioma de destino, y habla. Añade o reordena tus idiomas de destino en Inicio y cámbialos desde el teclado."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「翻訳」とターゲット言語を選んで話してください。ターゲット言語の追加や並べ替えはホームで、切り替えはキーボードで行えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "번역과 대상 언어를 고른 뒤 말하세요. 대상 언어는 홈에서 추가하거나 순서를 바꾸고, 키보드에서 전환할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择“翻译”和目标语言，然后说话。在主页添加或调整目标语言顺序，在键盘上切换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇「翻譯」和目標語言，然後說話。在首頁新增或調整目標語言順序，在鍵盤上切換。"
          }
        }
      }
    },
