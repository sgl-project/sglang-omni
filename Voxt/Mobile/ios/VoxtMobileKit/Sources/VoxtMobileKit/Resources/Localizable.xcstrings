    },
    "Use up to 8 different style examples, each up to 120 characters, keeping the same numbers." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use up to 8 different style examples, each up to 120 characters, keeping the same numbers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa hasta 8 ejemplos de estilo distintos, de hasta 120 caracteres cada uno, sin cambiar los números."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文体の例は最大 8 組、各文章は 120 文字以内で、数字を変えずに保存してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서로 다른 스타일 예시는 8개까지, 각 120자 이내로 쓰고 숫자는 그대로 두세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
