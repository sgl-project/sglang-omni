        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el botón del teclado para escribir. Desliza la fila de idiomas para cambiar de distribución o volver a la voz. Mantén pulsada una letra para ver los acentos."
          }
