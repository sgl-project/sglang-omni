    "Local models are required unless you enable Allow cloud models. History sync transfers saved text, without audio." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Local models are required unless you enable Allow cloud models. History sync transfers saved text, without audio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesitan modelos locales a menos que actives Permitir modelos en la nube. La sincronización del historial transfiere el texto guardado, sin audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「クラウドモデルを許可」を有効にしない限り、ローカルモデルのみ使用します。履歴同期では保存したテキストのみ転送し、音声は転送しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클라우드 모델 허용을 켜지 않으면 로컬 모델이 필요합니다. 기록 동기화는 저장된 텍스트만 보내고 오디오는 보내지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认仅使用本地模型，可在“允许云端模型”中更改。历史同步只传输保存的文字，不含音频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預設僅使用本機模型，可在「允許雲端模型」中變更。歷史同步只傳送儲存的文字，不含音訊。"
          }
        }
      }
    },
    "Local models are required unless you enable Allow cloud models. This history stays on your iPhone. Mac history is managed separately." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Local models are required unless you enable Allow cloud models. This history stays on your iPhone. Mac history is managed separately."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesitan modelos locales a menos que actives Permitir modelos en la nube. Este historial se queda en tu iPhone. El historial del Mac se gestiona por separado."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「クラウドモデルを許可」を有効にしない限り、ローカルモデルのみ使用します。この履歴は iPhone に保存され、Mac の履歴は別に管理されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클라우드 모델 허용을 켜지 않으면 로컬 모델이 필요합니다. 이 기록은 iPhone에만 남습니다. Mac의 기록은 따로 관리됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认仅使用本地模型，可在“允许云端模型”中更改。此历史保存在 iPhone 上，Mac 历史单独管理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預設僅使用本機模型，可在「允許雲端模型」中變更。此歷史儲存在 iPhone 上，Mac 歷史另外管理。"
          }
        }
      }
    },
