    "iOS asks this of every keyboard that works with its own app. Voxt's keyboard uses it only to pass your recording to the Voxt app and to get the text back." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS asks this of every keyboard that works with its own app. Voxt's keyboard uses it only to pass your recording to the Voxt app and to get the text back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS lo pide a todos los teclados que funcionan con su propia app. El teclado de Voxt solo lo usa para pasar tu grabación a la app Voxt y recibir el texto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分の App と連携するキーボードには、iOS が必ずこれを求めます。Voxt のキーボードは、録音を Voxt App に渡してテキストを受け取るためだけに使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS는 자체 앱과 함께 동작하는 모든 키보드에 이것을 요청합니다. Voxt 키보드는 녹음을 Voxt 앱에 넘기고 글을 돌려받는 데만 씁니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "凡是需要和自己 App 配合的键盘，iOS 都会这样询问。Voxt 键盘只用它把录音交给 Voxt App，并取回文字。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "凡是需要和自己 App 配合的鍵盤，iOS 都會這樣詢問。Voxt 鍵盤只用它把錄音交給 Voxt App，並取回文字。"
          }
        }
      }
    },
    "iOS shows this warning for every keyboard with Full Access." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS shows this warning for every keyboard with Full Access."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS muestra este aviso para todos los teclados con acceso completo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS はフルアクセスを使うすべてのキーボードでこの警告を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS는 전체 접근을 쓰는 모든 키보드에 이 경고를 표시합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 会对每个使用完全访问的键盘显示这条警告。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 會對每個使用完整取用的鍵盤顯示這則警告。"
          }
        }
      }
    },
