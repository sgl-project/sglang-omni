    "Inserts your words as spoken, without cleanup or formatting. Much faster. Dictionary spellings still apply." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserts your words as spoken, without cleanup or formatting. Much faster. Dictionary spellings still apply."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserta tus palabras tal como las dices, sin limpiarlas ni darles formato. Mucho más rápido. Las grafías del diccionario se siguen aplicando."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "話した言葉をそのまま入力します。文章や書式を整えないため、ずっと速く入力できます。辞書の表記は引き続き適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "말한 그대로 다듬거나 서식을 바꾸지 않고 넣습니다. 훨씬 빠릅니다. 사전에 넣은 철자는 그대로 적용됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按你说的原话输入，不润色、不整理格式，速度快得多。词典中的拼写仍会生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按你說的原話輸入，不潤飾、不整理格式，速度快得多。詞典中的拼寫仍會生效。"
          }
        }
      }
    },
