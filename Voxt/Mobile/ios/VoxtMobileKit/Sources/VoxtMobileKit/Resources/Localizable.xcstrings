          }
        }
      }
    },
    "Can't reach your Mac. Check that Tailscale is connected on this phone and Voxt is running on the Mac." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't reach your Mac. Check that Tailscale is connected on this phone and Voxt is running on the Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede conectar con tu Mac. Comprueba que Tailscale esté conectado en este teléfono y que Voxt esté abierto en el Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac に接続できません。この iPhone で Tailscale が接続され、Mac で Voxt が実行中か確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac에 연결할 수 없습니다. 이 휴대폰에서 Tailscale이 연결되어 있고 Mac에서 Voxt가 실행 중인지 확인하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接你的 Mac。请确认手机已连接 Tailscale，且 Mac 上正在运行 Voxt。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法連線到你的 Mac。請確認手機已連接 Tailscale，且 Mac 上正在執行 Voxt。"
          }
        }
      }
    },
    "Can't reach your Mac. Check your internet connection and make sure Voxt is running on the Mac." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't reach your Mac. Check your internet connection and make sure Voxt is running on the Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede conectar con tu Mac. Comprueba tu conexión a internet y que Voxt esté abierto en el Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac に接続できません。インターネット接続と、Mac で Voxt が実行中か確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac에 연결할 수 없습니다. 인터넷 연결을 확인하고 Mac에서 Voxt가 실행 중인지 확인하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接你的 Mac。请检查网络连接，并确认 Mac 上正在运行 Voxt。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法連線到你的 Mac。請檢查網路連線，並確認 Mac 上正在執行 Voxt。"
          }
        }
      }
    },
    "Cancel" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancel"
          }
        },
