    "Drag to change the order. The first one sits straight above the mic." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag to change the order. The first one sits straight above the mic."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra para cambiar el orden. El primero queda justo encima del micrófono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグで順番を変えられます。1番目はマイクの真上に出ます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끌어서 순서를 바꾸세요. 첫 번째 언어가 마이크 바로 위에 옵니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动可调整顺序。第一个就在麦克风正上方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移可調整順序。第一個就在麥克風正上方。"
          }
        }
      }
    },
    "Each prompt replaces Voxt's built-in instruction for that mode. Custom prompts can lower quality. An empty prompt uses the built-in one." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each prompt replaces Voxt's built-in instruction for that mode. Custom prompts can lower quality. An empty prompt uses the built-in one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada instrucción sustituye a la integrada de Voxt para ese modo. Las instrucciones personalizadas pueden empeorar la calidad. Si la dejas vacía, se usa la integrada."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各プロンプトはそのモードの組み込み指示を置き換えます。カスタムプロンプトは品質を下げることがあります。空欄の場合は組み込みのものを使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 프롬프트는 해당 모드의 Voxt 기본 지시를 대체합니다. 직접 만든 프롬프트는 품질을 떨어뜨릴 수 있습니다. 비워 두면 기본 프롬프트를 씁니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个提示词会替换该模式的内置指令。自定义提示词可能降低效果。留空则使用内置提示词。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個提示詞會取代該模式的內建指令。自訂提示詞可能降低效果。留空則使用內建提示詞。"
          }
        }
      }
    },
