          }
        }
      }
    },
    "Cancel stops recording or processing. If a request fails, Retry uses the same recording. If your cursor or selection changes before a result returns, copy the result from Home or History." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancel stops recording or processing. If a request fails, Retry uses the same recording. If your cursor or selection changes before a result returns, copy the result from Home or History."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancelar detiene la grabación o el procesamiento. Si una solicitud falla, Reintentar usa la misma grabación. Si el cursor o la selección cambian antes de que llegue el resultado, cópialo desde Inicio o Historial."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャンセルは録音または処理を停止します。リクエストが失敗した場合、「再試行」は同じ録音を使います。結果が返る前にカーソルや選択範囲が変わった場合は、ホームや履歴から結果をコピーできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "취소를 누르면 녹음이나 처리가 멈춥니다. 요청이 실패하면 다시 시도가 같은 녹음을 사용합니다. 결과가 오기 전에 커서나 선택이 바뀌면 홈이나 기록에서 결과를 복사하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“取消”会停止录音或处理。请求失败时，“重试”会使用同一段录音。如果结果返回前光标或选区变了，可以在主页或历史中拷贝结果。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「取消」會停止錄音或處理。請求失敗時，「重試」會使用同一段錄音。如果結果返回前游標或選取範圍變了，可以在首頁或歷史中拷貝結果。"
          }
        }
      }
    },
