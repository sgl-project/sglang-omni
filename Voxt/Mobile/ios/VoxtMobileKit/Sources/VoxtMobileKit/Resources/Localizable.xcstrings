    "“hi karen um the heater in 4B stopped working on tuesday, uh, can you send someone this week? thanks”" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“hi karen um the heater in 4B stopped working on tuesday, uh, can you send someone this week? thanks”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«hola karen eh la calefacción del 4B dejó de funcionar el martes, mm, ¿puedes mandar a alguien esta semana? gracias»"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「あの、カレンさん、えーと 4B の暖房が火曜から動かなくて、あの、今週だれか来てもらえますか？よろしく」"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“karen님 안녕하세요 어 4B호 난방기가 화요일부터 안 돼요, 음, 이번 주에 사람 좀 보내 주실 수 있나요? 감사합니다”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“嗨 karen 嗯 4B 的暖气周二坏了，呃，这周能派人来看看吗？谢谢”"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「嗨 karen 嗯 4B 的暖氣週二壞了，呃，這週能派人來看看嗎？謝謝」"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
