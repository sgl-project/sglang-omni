    "Your Mac hasn't turned these into text. They stay on this iPhone until they're sent or you delete them." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Mac hasn't turned these into text. They stay on this iPhone until they're sent or you delete them."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些录音还没变成文字。在发送成功或你删除之前，都保存在这台 iPhone 上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些錄音還沒變成文字。在傳送成功或你刪除之前，都保存在這台 iPhone 上。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらの録音はまだ Mac で文字になっていません。送信できるか削除するまで、この iPhone に保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 Mac에서 텍스트로 바뀌지 않은 녹음이에요. 보내지거나 삭제할 때까지 이 iPhone에 저장돼요."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Mac aún no las ha convertido en texto. Se quedan en este iPhone hasta que se envíen o las elimines."
          }
        }
      }
    },
