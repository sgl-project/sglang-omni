MyGo patch 0019: accept AppKit's generic file-drag operation.

A file drag whose source advertises only NSDragOperationGeneric was rejected
before the Rewrite panel saw its files. Treat that native effect as Copy in the
Go event, but answer AppKit with Generic when the source does not offer Copy.
The native test checks that the answer intersects the source mask.
diff --git a/internal/darwin/surface_drag.go b/internal/darwin/surface_drag.go
--- a/internal/darwin/surface_drag.go
+++ b/internal/darwin/surface_drag.go
@@ -156,6 +156,6 @@ func macOperations(o transfer.Operation) uint {
 func goOperations(n uint) transfer.Operation {
 	var o transfer.Operation
-	if n&1 != 0 {
+	if n&5 != 0 {
 		o |= transfer.Copy
 	}
 	if n&16 != 0 {
@@ -346,6 +346,11 @@ func (s *surface) nativeDataOperation(info id) uint {
 func (s *surface) nativeDataOperation(info id) uint {
 	if !s.nativeDataEvent(info, platform.DataDragOver) {
 		return 0
 	}
-	return macOperations(s.dragOperation)
+	operation := macOperations(s.dragOperation)
+	sourceOperations := uint(send(info, "draggingSourceOperationMask"))
+	if operation&sourceOperations == 0 && sourceOperations&4 != 0 {
+		return 4
+	}
+	return operation
 }
