diff --git a/internal/e2e/file_url_drop_operation_test.go b/internal/e2e/file_url_drop_operation_test.go
new file mode 100644
--- /dev/null
+++ b/internal/e2e/file_url_drop_operation_test.go
@@ -0,0 +1,42 @@
+//go:build darwin
+
+package e2e
+
+import (
+	"os"
+	"path/filepath"
+	"slices"
+	"sync/atomic"
+	"testing"
+
+	"github.com/egoist/mygo"
+	"github.com/egoist/mygo/internal/darwin"
+	"github.com/egoist/mygo/ui"
+)
+
+// TestContentWindowGenericFileDrop uses the Rewrite panel's exact window
+// options with a source that offers only NSDragOperationGeneric (4).
+func TestContentWindowGenericFileDrop(t *testing.T) {
+	w := newWindow(t, mygo.WindowOptions{
+		Title: "Rewrite", Width: 480, Height: 340, UseContentSize: true, Hidden: true,
+		Frameless: true, Transparent: true, Vibrancy: mygo.VibrancyHUD,
+		Panel: true, DisableResize: true, DisableClose: true,
+		Content: ui.View(func(c *ui.Context) { ui.Text(c, "Rewrite") }),
+	})
+	var event atomic.Pointer[mygo.FileDropEvent]
+	w.OnFileDrop(func(e *mygo.FileDropEvent) { event.Store(e) })
+	path := filepath.Join(t.TempDir(), "picture.png")
+	if err := os.WriteFile(path, []byte("fixture"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	var over, dropped bool
+	mygo.RunOnMain(func() {
+		over, dropped = darwin.TestDropFilesOperation(w.NativeHandle(), 50, 50, []string{path}, 4)
+	})
+	if !over || !dropped {
+		t.Fatalf("the panel refused a generic file drag: over %v, dropped %v", over, dropped)
+	}
+	if e := event.Load(); e == nil || !slices.Equal(e.Paths, []string{path}) {
+		t.Fatalf("OnFileDrop got %+v, want path %q", e, path)
+	}
+}
