+package e2e
+
+import (
+	"path/filepath"
+	"slices"
+	"sync/atomic"
+	"testing"
+
+	"github.com/egoist/mygo"
+	"github.com/egoist/mygo/transfer"
+	"github.com/egoist/mygo/ui"
+)
+
+// TestContentWindowFileURLDrop drops a local file offered only as public.url,
+// without the file-list type Finder also provides, onto a native panel.
+func TestContentWindowFileURLDrop(t *testing.T) {
+	w := newWindow(t, mygo.WindowOptions{
+		Title: "Rewrite", Width: 480, Height: 340, UseContentSize: true, Hidden: true,
+		Frameless: true, Transparent: true, Vibrancy: mygo.VibrancyHUD,
+		Panel: true, DisableResize: true, DisableClose: true,
+		Content: ui.View(func(c *ui.Context) { ui.Text(c, "Rewrite") }),
+	})
+	var event atomic.Pointer[mygo.FileDropEvent]
+	w.OnFileDrop(func(e *mygo.FileDropEvent) { event.Store(e) })
+	data := transfer.New(transfer.NewItem(transfer.Bytes(transfer.URIList, []byte("file:///tmp/picture.png"))))
+	operation, dropped, supported := dropNativeData(w, 50, 50, data, transfer.Copy)
+	if !supported {
+		t.Skip("native data-drop automation not available on this platform")
+	}
+	if operation != transfer.Copy || !dropped {
+		t.Fatalf("the panel refused a file URL: operation %v, dropped %v", operation, dropped)
+	}
+	want := []string{filepath.FromSlash("/tmp/picture.png")}
+	if e := event.Load(); e == nil || !slices.Equal(e.Paths, want) {
+		t.Fatalf("OnFileDrop got %+v, want paths %v", e, want)
+	}
+}
