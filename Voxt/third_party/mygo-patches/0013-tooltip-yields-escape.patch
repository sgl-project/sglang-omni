+// TestTooltipLetsDialogClose checks that one Escape closes a dialog whose
+// focused button shows its tip, rather than only hiding the tip.
+func TestTooltipLetsDialogClose(t *testing.T) {
+	open := true
+	tt, _ := clockTester(func(c *context) {
+		coreDialogBase(c, &open, func(_, panel *node) {
+			coreButton(c, "Close").Tooltip("Closes the dialog")
+		})
+	}, 400, 300)
+	tt.Key(0, KeyTab)
+	if !tt.HasText("Closes the dialog") {
+		t.Fatalf("no tip for the focus; texts %q", tt.Texts())
+	}
+	tt.Key(0, KeyEscape)
+	if open {
+		t.Error("the first Escape left the dialog open")
+	}
+}
