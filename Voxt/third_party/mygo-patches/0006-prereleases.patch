+// TestNotPublished: a feed without a version yet leaves the app up to
+// date.
+func TestNotPublished(t *testing.T) {
+	saved := updaterCheck
+	t.Cleanup(func() { updaterCheck = saved })
+	updaterCheck = func(context.Context) (*mygo.Update, error) {
+		return nil, fmt.Errorf("mygo: checking for updates: %w", mygo.ErrNotPublished)
+	}
+	if r, err := checkRelease(context.Background()); r != nil || err != nil {
+		t.Errorf("checkRelease = %v, %v, want up to date", r, err)
+	}
+	updaterCheck = func(context.Context) (*mygo.Update, error) { return nil, errors.New("offline") }
+	if _, err := checkRelease(context.Background()); err == nil || err.Error() != "offline" {
+		t.Errorf("checkRelease = %v, want offline", err)
+	}
