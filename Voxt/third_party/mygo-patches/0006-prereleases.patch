+		mu.Lock()
+		defer mu.Unlock()
+		if broken && strings.Contains(r.URL.Path, "/beta/") {
+			http.Error(w, "down", http.StatusBadGateway)
+			return
+		}
+		v := channels[r.URL.Path]
+		if v == "" {
+			http.NotFound(w, r)
+			return
+		}
+		fmt.Fprintf(w, `{"version": %q, "url": "https://example.com/app-%s.tar.gz", "size": 1, "signature": "sig"}`, v, v)
+	}))
+	defer srv.Close()
+	feed, betaFeed := srv.URL+"/app/update.json", srv.URL+"/app/beta/update.json"
+	set := func(release, beta string, down bool) {
+		mu.Lock()
+		channels["/app/update.json"], channels["/app/beta/update.json"], broken = release, beta, down
+		mu.Unlock()
+	}
