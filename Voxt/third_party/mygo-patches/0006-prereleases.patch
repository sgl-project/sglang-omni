+		release, beta string
+		down          bool
+		current       string
+		pre           bool
+		want          string
+	}{
+		// A fix published after a beta of the next version.
+		{"1.2.1", "1.3.0-beta.2", false, "1.2.0", false, "1.2.1"},
+		{"1.2.1", "1.3.0-beta.2", false, "1.2.0", true, "1.3.0-beta.2"},
+		{"1.2.1", "1.3.0-beta.2", false, "1.3.0-beta.1", true, "1.3.0-beta.2"},
+		{"1.2.1", "1.3.0-beta.2", false, "1.3.0-beta.2", true, "up to date"},
+		{"1.2.1", "1.3.0-beta.2", false, "1.3.0-beta.1", false, "up to date"}, // never back to 1.2.1
