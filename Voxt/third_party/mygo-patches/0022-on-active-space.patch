@@ -286,6 +286,23 @@ func TestWindowExtras(t *testing.T) {
 	}
 }
 
+// IsOnActiveSpace reports what the platform says: off another app's
+// full-screen Space (macOS), a regular app's ordinary window is not there.
+func TestIsOnActiveSpace(t *testing.T) {
+	w, fw := testWindow(t, WindowOptions{})
+	if !w.IsOnActiveSpace() {
+		t.Error("IsOnActiveSpace = false on the active workspace")
+	}
+	onMain(func() { fw.OffActiveSpace = true })
+	if w.IsOnActiveSpace() {
+		t.Error("IsOnActiveSpace = true off the active workspace")
+	}
+	w.Destroy()
+	if w.IsOnActiveSpace() {
+		t.Error("IsOnActiveSpace = true for a destroyed window")
+	}
+}
