+// A paragraph over the ordinary budget (a long History record) is kept
+// while frames draw it, so they do not shape it again, and trimmed once
+// they stop.
+func TestLayoutCacheKeepsLargeParagraph(t *testing.T) {
+	s := newSystem()
+	s.eng = &stubEngine{}
+	p := Params{Text: "a small label"}
+	l := s.Layout(p)
+	big := Params{Text: strings.Repeat("x", maxLayoutBytes/32)}
+	if n := layoutBytes(s.layout(big)); n <= maxLayoutBytes {
+		t.Fatalf("the paragraph takes %d bytes, within the budget", n)
+	}
+	large := s.Layout(big)
+	s.EndFrame()
+	made := s.LayoutsMade()
+	for range 20 {
+		if s.Layout(big) != large || s.Layout(p) != l {
+			t.Fatal("a frame shaped the displayed text again")
+		}
+		s.EndFrame()
+	}
+	if n := s.LayoutsMade() - made; n != 0 {
+		t.Fatalf("made %d layouts for unchanged text", n)
+	}
+	for range liveLayoutFrames {
+		s.Layout(p)
+		s.EndFrame()
+	}
+	if s.layoutBytes > maxLayoutBytes || s.Layout(p) != l {
+		t.Fatalf("kept %d bytes after the paragraph went out of use", s.layoutBytes)
+	}
+}
