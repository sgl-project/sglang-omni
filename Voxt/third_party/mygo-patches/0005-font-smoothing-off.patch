MyGo patch 0005 (Auralink): Content.FontSmoothing turns font smoothing
off for a window's text.

On macOS MyGo rasterizes glyphs as AppKit draws text over an opaque
background: with Core Text's font smoothing while the user leaves it on,
which emboldens glyphs, the more the lighter the text (the shades of
internal/text). Auralink's floating windows (the recording pill, the
answer card, its language menu) are transparent panels whose white text
lies over a dark, translucent HUD, where the user finds that weight
heavy. A window can now draw its text as Flat glyphs, without smoothing,
as browsers draw text styled -webkit-font-smoothing: antialiased.

ui.View(v).FontSmoothing(false) sets it for the windows showing the
content; Tester.SetFontSmoothing does for a tester. The painter draws
every glyph of such a window in the Flat shade (Painter.shadeOf), whatever
its color; thickened glyphs stay thick. The text system and its glyph
cache are shared by all windows, and its keys hold the shade, so Flat
glyphs are cached apart from the shaded ones and the other windows' text
is unchanged (TestFlatCachedApart). Other
platforms do not smooth fonts this way and draw Flat as other text.
diff --git a/internal/text/text_test.go b/internal/text/text_test.go
index 787a875..1efcdff 100644
--- a/internal/text/text_test.go
+++ b/internal/text/text_test.go
@@ -882,3 +882,38 @@ func TestSetLanguage(t *testing.T) {
 		t.Error("the same language made a new generation")
 	}
 }
+
+// TestFlatCachedApart keeps Flat glyphs of a shaded font apart from its
+// glyphs of each shade in the cache, so that windows drawing without font
+// smoothing (ui.Content.FontSmoothing) leave the others' text as it is.
+func TestFlatCachedApart(t *testing.T) {
+	s := newSystem()
+	l := s.Layout(Params{Text: "O", Style: Style{Size: 13}})
+	g := l.Lines[0].Glyphs[0]
+	shaded := *g.Font
+	shaded.shaded = true
+	keys := map[Shade]glyphKey{}
+	for _, shade := range []Shade{0, Shades - 1, Flat} {
+		n := len(s.glyphs)
+		s.Glyph(&shaded, g.ID, 2, 0, shade, false)
+		if len(s.glyphs) != n+1 {
+			t.Fatalf("shade %d: %d glyphs cached, want %d", shade, len(s.glyphs), n+1)
+		}
+		for k := range s.glyphs {
+			if k.shade == shade {
+				keys[shade] = k
+			}
+		}
+	}
+	if keys[Flat] == keys[Shades-1] || keys[Flat] == keys[0] {
+		t.Errorf("Flat glyphs share a key with a shade: %v", keys)
+	}
+	// Again: each comes from the cache.
+	n := len(s.glyphs)
+	for _, shade := range []Shade{Flat, Shades - 1, 0} {
+		s.Glyph(&shaded, g.ID, 2, 0, shade, false)
+	}
+	if len(s.glyphs) != n {
+		t.Errorf("drawing the glyphs again cached %d more", len(s.glyphs)-n)
+	}
+}
