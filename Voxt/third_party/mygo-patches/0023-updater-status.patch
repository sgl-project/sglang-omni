diff --git a/plugins/updater/updater_test.go b/plugins/updater/updater_test.go
index 80b4fc7..15f0a7b 100644
--- a/plugins/updater/updater_test.go
+++ b/plugins/updater/updater_test.go
@@ -566,3 +566,53 @@ func TestNotPublished(t *testing.T) {
 		t.Errorf("checkRelease = %v, want offline", err)
 	}
 }
+
+func TestUpdaterStatus(t *testing.T) {
+	h := newHarness(t, Options{})
+	prev := active.Swap(h.u)
+	t.Cleanup(func() { active.Store(prev) })
+
+	if AvailableVersion() != "" || InstalledVersion() != "" {
+		t.Fatalf("initial status: avail=%q inst=%q", AvailableVersion(), InstalledVersion())
+	}
+
+	// Finding an update records AvailableVersion even if the user chooses Remind Me Later.
+	h.result = func(context.Context) (*release, error) {
+		return newRelease("2.1.4", nil), nil
+	}
+	done := h.begin(false)
+	s := h.shown()
+	v := waitView(t, s, "A new version of")
+	if got := AvailableVersion(); got != "2.1.4" {
+		t.Fatalf("available %q, want 2.1.4", got)
+	}
+	s.Respond(v.Prompt, actionLater, false)
+	waitDone(t, done)
+	if got := AvailableVersion(); got != "2.1.4" {
+		t.Fatalf("after Remind Later: available %q, want 2.1.4", got)
+	}
+
+	// Skipping clears AvailableVersion.
+	done = h.begin(true)
+	s = h.shown()
+	v = waitView(t, s, "A new version of")
+	s.Respond(v.Prompt, actionSkip, false)
+	waitDone(t, done)
+	if got := AvailableVersion(); got != "" {
+		t.Fatalf("after Skip: available %q, want empty", got)
+	}
+
+	// Background automatic install clears AvailableVersion and sets InstalledVersion.
+	SetAutomaticDownloads(true)
+	h.result = func(context.Context) (*release, error) {
+		return newRelease("2.1.5", nil), nil
+	}
+	done = h.begin(false)
+	waitDone(t, done)
+	if got := AvailableVersion(); got != "" {
+		t.Fatalf("after install: available %q, want empty", got)
+	}
+	if got := InstalledVersion(); got != "2.1.5" {
+		t.Fatalf("after install: installed %q, want 2.1.5", got)
+	}
+}
