 		runSize := size
 		if f := run.font; f != nil {
@@ -1016,14 +1020,14 @@ func line(p Params, text []rune, sl shapedLine, offset int, rtl bool, m lineMetr
 			// Logical width follows the pen, not the glyphs' drawing
