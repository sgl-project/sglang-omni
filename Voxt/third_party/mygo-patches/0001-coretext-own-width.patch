diff --git a/internal/text/text_test.go b/internal/text/text_test.go
index 7b84ee2..787a875 100644
--- a/internal/text/text_test.go
+++ b/internal/text/text_test.go
@@ -85,6 +85,43 @@ func TestTruncation(t *testing.T) {
 	}
 }
 
+// A text laid out at its own width keeps to one line. Core Text spaces a
+// bracket apart from a letter of another script, between runs of two fonts
+// by moving glyphs alone, which the width must count; and it forgives a
+// width short of its own by 0.0002 at most, less than float32 widths of
+// long lines can lose.
+func TestOwnWidthFits(t *testing.T) {
+	s := Shared()
+	for _, size := range []float32{11, 12, 13, 14, 20} {
+		for _, weight := range []int{400, 600} {
+			for _, str := range []string{
+				"M4B（含章节）", "标题(可选)", "M4B（含章节）尾", "标题（可选）", "M4B (含章节)",
+				"含章节的 M4B", "Format (M4B)", "مرحبا (M4B) عالم", "已完成，共三章",
+				"Downloads start when you finish, and go on in the background.",
+				"Wait for the jobs in progress to finish, or cancel them, first.",
+				"AudioSmith 在这台 Mac 上运行：这些权限只用于每一行说明的用途，音频不会离开这台 Mac。",
+				"AudioSmith 用 macOS 自带的 AVFoundation 读写音视频。ffmpeg 是一个免费的媒体工具，装上后可以导出 MP3、Opus 和 FLAC，读取 WebM 和 MKV 视频，并把字幕烧录进视频。它是可选的，以独立程序运行。",
+				"Say how words are read: names, brands, abbreviations. Matching ignores case; in Chinese and Japanese a term matches inside words too. In a script, [[word|say it like this]] changes one place only.",
+			} {
+				style := Style{Size: size, Weight: weight}
+				full := s.Layout(Params{Text: str, Style: style})
+				line := full.Lines[0]
+				var right float32
+				for _, g := range line.Glyphs {
+					right = max(right, g.X+g.Advance)
+				}
+				if right > full.Width+1e-3 {
+					t.Errorf("%v/%d %q: glyphs reach %v, the line is %v wide", size, weight, str, right, full.Width)
+				}
+				l := s.Layout(Params{Text: str, Style: style, Width: full.Width, MaxLines: 1})
+				if l.Truncated || len(l.Lines) != 1 || l.Lines[0].End != len(l.Runes) {
+					t.Errorf("%v/%d %q at its own width %v: truncated %v, %d lines", size, weight, str, full.Width, l.Truncated, len(l.Lines))
+				}
+			}
+		}
+	}
+}
