+// TestScrollLatches: a scroll gesture stays with the container it started
+// to move. The page scrolling down goes on when a scroll container inside
+// it comes under the pointer, rather than the inner one taking the rest
+// of the gesture; the inner one takes a gesture that starts over it, once
+// the one before paused for longer than scrollGap.
+func TestScrollLatches(t *testing.T) {
+	var page, inner ScrollState
+	tt := coreNewTester(func(c *context) {
+		coreScroll(c).Fill().TrackScroll(&page).Children(func() {
+			coreBox(c).Height(100).Shrink(0)
+			coreScroll(c).Height(100).Shrink(0).TrackScroll(&inner).Children(func() {
+				coreBox(c).Height(1000).Shrink(0)
+			})
+			coreBox(c).Height(1000).Shrink(0)
+		})
+	}, 200, 200)
+	tt.Move(100, 50)
+	tt.Scroll(100, 50, 0, 60) // over the box above the inner container
+	tt.Scroll(100, 50, 0, 60) // the inner container is under the pointer now
+	if page.Y != 120 || inner.Y != 0 {
+		t.Fatalf("one gesture: the page at %v, the inner container at %v", page.Y, inner.Y)
+	}
+	tt.Advance(time.Second)
+	tt.Scroll(100, 50, 0, 30)
+	if page.Y != 120 || inner.Y != 30 {
+		t.Errorf("a new gesture over the inner container: the page at %v, the inner one at %v", page.Y, inner.Y)
+	}
+	// It stays with the inner container at its end too.
+	tt.Scroll(100, 50, 0, 5000)
+	tt.Scroll(100, 50, 0, 60)
+	if page.Y != 120 {
+		t.Errorf("the inner container at its end handed the gesture to the page, at %v", page.Y)
+	}
+}
+
+// TestScrollLatchGone: a gesture's container that the view no longer
+// builds (another page shows) does not keep the gesture: the next event
+// within scrollGap scrolls what is under the pointer.
+func TestScrollLatchGone(t *testing.T) {
+	var first, second ScrollState
+	showFirst := true
+	tt := coreNewTester(func(c *context) {
+		if showFirst {
+			coreScroll(c).Fill().TrackScroll(&first).Children(func() { coreBox(c).Height(1000).Shrink(0) })
+		} else {
+			coreScroll(c).Fill().TrackScroll(&second).Children(func() { coreBox(c).Height(1000).Shrink(0) })
+		}
+	}, 200, 200)
+	tt.Move(100, 100)
+	tt.Scroll(100, 100, 0, 40)
+	showFirst = false
+	tt.Frame()
+	tt.Scroll(100, 100, 0, 40)
+	if first.Y != 40 || second.Y != 40 {
+		t.Errorf("after the first page went: the first at %v, the second at %v", first.Y, second.Y)
+	}
+}
