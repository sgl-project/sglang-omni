+
+// TestTextAreaRevealsInPage: a text area as high as its text has nothing
+// of its own to scroll, so the caret it is to show is shown by the
+// containers around it: at a selection the app sets and as the user moves
+// it; an edit the app makes while the area does not have the focus moves
+// nothing.
+func TestTextAreaRevealsInPage(t *testing.T) {
+	var b strings.Builder
+	for i := range 100 {
+		b.WriteString("line " + strconv.Itoa(i) + "\n")
+	}
+	s := b.String()
+	var page ScrollState
+	selectAt := -1
+	tt := coreNewTester(func(c *context) {
+		coreScroll(c).Fill().TrackScroll(&page).Children(func() {
+			coreBox(c).Height(50).Shrink(0)
+			ta := coreTextArea(c, &s).Lines(1, math.MaxInt32).Width(300).Shrink(0)
+			if selectAt >= 0 {
+				ta.SetTextSelection(selectAt, selectAt)
+				selectAt = -1
+			}
+		})
+	}, 400, 300)
+	tt.Frame()
+	s += "one more line\n"
+	tt.Frame()
+	tt.Frame()
+	if page.Y != 0 {
+		t.Fatalf("an edit by the app scrolled the page to %v", page.Y)
+	}
+	selectAt = utf8.RuneCountInString(s) - 3
+	tt.Frame()
+	tt.Frame()
+	if page.Y < 1000 {
+		t.Fatalf("a selection near the end left the page at %v", page.Y)
+	}
+	tt.Press(100, 150)
+	tt.Release(100, 150)
+	tt.Key(Ctrl, KeyHome)
+	tt.Frame()
+	if caret, ok := tt.TextCaret(); !ok || page.Y > 60 || caret.Y < 0 || caret.Y+caret.H > 300 {
+		t.Errorf("the caret at the start: the page at %v, the caret at %+v (%v)", page.Y, caret, ok)
+	}
+}
