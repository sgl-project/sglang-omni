+func OpaqueColorPicker(c *Context, color *Color, action func()) Element {
+	ctx := c.build()
+	if ctx == nil {
+		return Element{}
+	}
+	ctx.rt.beginBuild()
+	e := colorPicker(ctx, color, false, action)
+	ctx.rt.endBuild()
+	return wrapElement(e)
+}
